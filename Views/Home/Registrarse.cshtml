<div class="auth-container">
    <div class="auth-card">
        <h1>Crear Cuenta</h1>
        <p class="subtitle">Únete a nuestra comunidad hoy</p>

        @if (!string.IsNullOrEmpty(ViewBag.mensaje))
        {
            <div class="error-message visible">@ViewBag.mensaje</div>
        }

        <form action="@Url.Action("Registrado", "Home")" method="post" class="auth-form">
            <div class="form-group">
                <label for="nombreUsuario">Nombre de Usuario</label>
                <input type="text" id="nombreUsuario" name="NombreUsuario" placeholder="Elige un nombre único" oninput="validoNombredeUsuario()" />
                <div class="validation-message" id="mensajeNombreUsuario"></div>
            </div>

            <div class="form-group">
                <label for="contraseña">Contraseña</label>
                <input type="password" id="contraseña" name="Contraseña" placeholder="Al menos 8 caracteres" oninput="validoContraseña()" />
                <div class="validation-message" id="mensajeContraseña"></div>
            </div>

            <div class="form-group">
                <label for="contraseña2">Confirmar Contraseña</label>
                <input type="password" id="contraseña2" name="Contraseña" placeholder="Repite tu contraseña" oninput="contraseñasIguales()" />
                <div class="validation-message" id="mensajeContraseña2"></div>
            </div>

            <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="Nombre" placeholder="Tu nombre" oninput="validoNombre()" />
                <div class="validation-message" id="mensajeNombre"></div>
            </div>

            <div class="form-group">
                <label for="apellido">Apellido</label>
                <input type="text" id="apellido" name="Apellido" placeholder="Tu apellido" oninput="validoApellido()" />
                <div class="validation-message" id="mensajeApellido"></div>
            </div>

            <button type="submit" class="auth-button">Registrarse</button>
        </form>

        <div class="auth-footer">
            <p>¿Ya tenés cuenta?</p>
            <a href="@Url.Action("IniciarSesion", "Home")" class="auth-toggle-link">Inicia Sesión Aquí</a>
        </div>
    </div>
</div>

<script src="~/js/site.js"></script>