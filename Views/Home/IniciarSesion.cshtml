<div class="auth-container">
    <div class="auth-card">
        <h1>Iniciar Sesión</h1>
        <p class="subtitle">Bienvenido de vuelta</p>

        @if (!string.IsNullOrEmpty(ViewBag.mensaje))
        {
            <div class="error-message visible">@ViewBag.mensaje</div>
        }

        <form action="@Url.Action("Logueado", "Home")" method="post" class="auth-form">
            <div class="form-group">
                <label for="nombreUsuario">Nombre de Usuario</label>
                <input type="text" id="nombreUsuario" name="NombreUsuario" placeholder="Tu nombre de usuario" oninput="validoNombredeUsuario()" />
                <div class="validation-message" id="mensajeNombreUsuario"></div>
            </div>

            <div class="form-group">
                <label for="contraseña">Contraseña</label>
                <input type="password" id="contraseña" name="Contraseña" placeholder="Tu contraseña" oninput="validoContraseña()" />
                <div class="validation-message" id="mensajeContraseña"></div>
            </div>

            <button type="submit" class="auth-button">Iniciar Sesión</button>
        </form>

        <div class="auth-footer">
            <p>¿No tenés cuenta?</p>
            <a href="@Url.Action("Registrarse", "Home")" class="auth-toggle-link">Registrate Aquí</a>
        </div>
    </div>
</div>

<script src="~/js/site.js"></script>