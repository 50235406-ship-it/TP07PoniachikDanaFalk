@{
    ViewData["Title"] = "Publicaciones";
}

<h1>Bienvenida al sistema</h1>
<h2>¡Hola, @Context.Session.GetString("Nombre")!</h2>

<div class="card">
    <h3>Datos de tu cuenta</h3>
    <div style="margin-top: 1.5rem;">
        <p><strong>ID:</strong> @Context.Session.GetInt32("ID")</p>
        <p><strong>Nombre de usuario:</strong> @Context.Session.GetString("NombreUsuario")</p>
        <p><strong>Nombre:</strong> @Context.Session.GetString("Nombre")</p>
        <p><strong>Apellido:</strong> @Context.Session.GetString("Apellido")</p>
        <p><strong>Tipo de usuario:</strong> @Context.Session.GetString("TipoUsuario")</p>
    </div>
</div>

<div style="margin-top: 2rem;">
    <a href="@Url.Action("Logout", "Home")" class="btn btn-danger">Cerrar sesión</a>
</div>

<section class="publication-page">
    <div class="publication-shell">
        <div class="welcome-panel">
            <p class="eyebrow">Comunidad</p>
            <h1>Publicaciones</h1>
            <p>Bienvenido/a, @Context.Session.GetString("Nombre") @Context.Session.GetString("Apellido").</p>
        </div>

        <div class="publication-layout">
            <div class="publication-form-card">
                <h2>Crear publicación</h2>
                <form id="publicationForm">
                    <div class="input-group">
                        <label for="titulo">Título</label>
                        <input id="titulo" name="titulo" type="text" maxlength="200" placeholder="¿Qué quieres compartir?" required />
                    </div>

                    <div class="input-group">
                        <label for="descripcion">Descripción</label>
                        <textarea id="descripcion" name="descripcion" rows="5" maxlength="500" placeholder="Escribe aquí tu publicación..." required></textarea>
                    </div>

                    <div class="input-group">
                        <label for="imagen">Imagen (opcional)</label>
                        <input id="imagen" name="imagen" type="text" placeholder="Nombre del archivo o URL" />
                    </div>

                    <button type="submit" class="primary-button">Publicar</button>
                </form>
            </div>

            <div class="posts-card">
                <div class="posts-header">
                    <h2>Últimas publicaciones</h2>
                </div>
                <div id="postList" class="post-list">
                    <p class="empty-state">Cargando publicaciones...</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const form = document.getElementById('publicationForm');
        const postList = document.getElementById('postList');

        function formatDate(dateString) {
            const date = new Date(dateString);
            return new Intl.DateTimeFormat('es-AR', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }).format(date);
        }

        async function loadPublicaciones() {
            try {
                const response = await fetch('@Url.Action("ObtenerPublicaciones", "Home")');

                if (!response.ok) {
                    throw new Error('No se pudieron cargar las publicaciones');
                }

                const publicaciones = await response.json();

                if (!publicaciones.length) {
                    postList.innerHTML = '<p class="empty-state">Todavía no hay publicaciones. ¡Sé el primero en compartir algo!</p>';
                    return;
                }

                postList.innerHTML = publicaciones.map(publicacion => `
                    <article class="post-item">
                        <div class="post-header">
                            <div>
                                <h3>${publicacion.titulo}</h3>
                                <p class="post-meta">Por <strong>${publicacion.nombreUsuario}</strong> • ${formatDate(publicacion.fechaPublicacion)}</p>
                            </div>
                        </div>
                        <p class="post-body">${publicacion.descripcion}</p>
                        ${publicacion.imagen ? `<div class="post-image"><img src="${publicacion.imagen}" alt="${publicacion.titulo}" /></div>` : ''}
                    </article>
                `).join('');
            } catch (error) {
                postList.innerHTML = '<p class="empty-state">Ocurrió un error al cargar las publicaciones.</p>';
            }
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const titulo = document.getElementById('titulo').value.trim();
            const descripcion = document.getElementById('descripcion').value.trim();
            const imagen = document.getElementById('imagen').value.trim();

            if (!titulo || !descripcion) {
                return;
            }

            const response = await fetch('@Url.Action("GuardarPublicacion", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ titulo, descripcion, imagen })
            });

            const resultado = await response.json();

            if (!response.ok) {
                alert(resultado.message || 'No se pudo guardar la publicación.');
                return;
            }

            form.reset();
            await loadPublicaciones();
        });

        document.addEventListener('DOMContentLoaded', loadPublicaciones);
    </script>
}
